+/* The application may choose bounded delivery instead of appending another
+ * segmented transaction behind one that lower transport is still repairing.
+ * Unsegmented control messages remain independent of this serialization.
+ */
+bool mesh_net_sar_pending(struct mesh_net *net, uint16_t dst)
+{
+	return net && (l_queue_find(net->sar_out, match_sar_remote,
+						L_UINT_TO_PTR(dst)) ||
+			l_queue_find(net->sar_queue, match_sar_remote,
+						L_UINT_TO_PTR(dst)));
+}
+
+/* SeqAuth identifies a transfer across retries. The reserved network sequence
+ * numbers keep it unique across daemon restarts within this node identity.
+ * Zero denotes sends that do not leave an outstanding unicast SAR.
+ */
+static uint64_t sar_token(const struct mesh_sar *sar)
+{
+	return (((uint64_t) sar->iv_index << 24) | sar->seqAuth) + 1;
+}
+
+uint64_t mesh_net_sar_token(struct mesh_net *net, uint16_t src, uint16_t dst)
+{
+	struct mesh_sar *sar;
+
+	if (!net)
+		return 0;
+
+	sar = l_queue_find(net->sar_out, match_sar_remote, L_UINT_TO_PTR(dst));
+	if (!sar || sar->src != src)
+		return 0;
+
+	sar->application_owned = true;
+	return sar_token(sar);
+}
+
+static bool match_sar_token(const void *a, const void *b)
+{
+	const struct mesh_sar *sar = a;
+	const uint64_t *token = b;
+
+	return sar->application_owned && sar_token(sar) == *token;
+}
+
+bool mesh_net_sar_active(struct mesh_net *net, uint64_t token)
+{
+	return net && token &&
+			l_queue_find(net->sar_out, match_sar_token, &token);
+}
+
+bool mesh_net_sar_cancel(struct mesh_net *net, uint64_t token)
+{
+	struct mesh_sar *sar;
+	uint16_t dst;
+
+	if (!net || !token)
+		return false;
+
+	sar = l_queue_remove_if(net->sar_out, match_sar_token, &token);
+	if (!sar)
+		return false;
+
+	dst = sar->remote;
+	/* Cancel both deferred local delivery and queued bearer repetitions
+	 * before admitting the next transaction for this destination.
+	 */
+	mesh_sar_free(sar);
+	send_queued_sar(net, dst);
+	return true;
+}
+
+static bool match_application_sar(const void *a, const void *b)
+{
+	const struct mesh_sar *sar = a;
+
+	return sar->application_owned;
+}
+
+void mesh_net_sar_cancel_application(struct mesh_net *net)
+{
+	struct mesh_sar *sar;
+
+	/* An application's D-Bus disconnect ends ownership of its tracked
+	 * transfers. Configuration-model traffic retains its own lifecycle.
+	 */
+	while ((sar = l_queue_find(net->sar_out, match_application_sar, NULL)))
+		mesh_net_sar_cancel(net, sar_token(sar));
+}
