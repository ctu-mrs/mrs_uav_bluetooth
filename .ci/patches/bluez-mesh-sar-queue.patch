+/* Packets remain owned by their network while waiting for the local
+ * delivery idle callback. SAR cancellation must cover that stage as well as
+ * the bearer queue, otherwise a cancelled retry can still reach the radio.
+ */
+struct packet_pattern {
+	const uint8_t *data;
+	uint8_t len;
+};
+
+static bool pending_tx_match(const void *a, const void *b)
+{
+	const struct oneshot_tx *tx = a;
+	const struct packet_pattern *pattern = b;
+
+	return tx->size == pattern->len &&
+			!memcmp(tx->packet, pattern->data, pattern->len);
+}
+
+static void pending_tx_free(void *data)
+{
+	struct oneshot_tx *tx = data;
+
+	l_idle_remove(tx->idle);
+	l_free(tx);
+}
+
+static bool net_packet_pending(struct mesh_net *net,
+					const uint8_t *packet, uint8_t len)
+{
+	struct packet_pattern pattern = { packet, len };
+
+	return l_queue_find(net->pending_tx, pending_tx_match, &pattern) ||
+					mesh_io_send_pending(net->io, packet, len);
+}
+
+static void net_cancel_packet(struct mesh_net *net,
+					const uint8_t *packet, uint8_t len)
+{
+	struct packet_pattern pattern = { packet, len };
+	struct oneshot_tx *tx;
+
+	while ((tx = l_queue_remove_if(net->pending_tx, pending_tx_match,
+								&pattern)))
+		pending_tx_free(tx);
+	mesh_io_send_cancel(net->io, packet, len);
+}
