diff --git a/mesh/node.c b/mesh/node.c
--- a/mesh/node.c
+++ b/mesh/node.c
@@ -539,8 +539,14 @@ static bool init_from_storage(struct mesh_config_node *db_node,
 	if (IS_UNICAST(node->primary) && node->num_ele) {
 		uint8_t stored_key[16];
 
-		if (!keyring_get_remote_dev_key(node, node->primary, stored_key) &&
-			!keyring_put_remote_dev_key(node, node->primary,
-						node->num_ele, node->dev_key))
-			goto fail;
+		/* A stale self entry makes local Config Server requests decrypt as
+		 * remote-device-key traffic. Reconcile it on every attach without
+		 * changing the node identity, network keys, or any peer keys.
+		 */
+		if (!keyring_get_remote_dev_key(node, node->primary, stored_key) ||
+				memcmp(stored_key, node->dev_key, 16)) {
+			if (!keyring_put_remote_dev_key(node, node->primary,
+						node->num_ele, node->dev_key))
+				goto fail;
+		}
 	}
