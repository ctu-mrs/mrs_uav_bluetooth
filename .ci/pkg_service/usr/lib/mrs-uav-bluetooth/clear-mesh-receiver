#!/usr/bin/python3
"""Disable a stale Linux MGMT Mesh receiver without touching bonds or keys.

The Mesh receive bit belongs to the controller, not to the daemon's socket.
Closing bluetooth-meshd (or taking/releasing a raw HCI bearer) can leave that
bit set. StopDiscovery then immediately restarts passive scanning and legacy
controllers reject subsequent advertising random-address changes.

Only MGMT Set Mesh Receiver(Enable=0) is sent. No device-removal, unpairing,
key-loading, controller-reset or filesystem-writing operations are performed.
The root-owned systemd wrapper supplies the selected controller.
"""
import ctypes
import re
import socket
import struct
import sys
import time

SET_MESH_RECEIVER = 0x0057
COMMAND_COMPLETE = 0x0001
COMMAND_STATUS = 0x0002


def disable_receiver(sock, index):
    """Send one bounded transaction; ignore unrelated multicast MGMT events.

    Some kernels validate scan timing even for Enable=0, so use valid equal
    window/period values rather than zero. Unsupported Mesh is already off.
    All other errors are surfaced to systemd and then the ROS overlay caller.
    """
    payload = struct.pack("<BHHB", 0, 0x1000, 0x1000, 0)
    sock.sendall(struct.pack("<HHH", SET_MESH_RECEIVER, index, len(payload)) + payload)
    deadline = time.monotonic() + 3.0
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("Mesh receiver disable did not complete")
        sock.settimeout(remaining)
        packet = sock.recv(4096)
        if len(packet) < 9:
            continue
        event, controller, length = struct.unpack_from("<HHH", packet)
        if controller != index or length < 3 or len(packet) < 6 + length:
            continue
        opcode, status = struct.unpack_from("<HB", packet, 6)
        if event not in (COMMAND_COMPLETE, COMMAND_STATUS) or opcode != SET_MESH_RECEIVER:
            continue
        if status in (0x01, 0x0C):  # Unknown Command / Not Supported: no Mesh receiver.
            return
        if status:
            raise RuntimeError(f"Mesh receiver disable failed: MGMT status 0x{status:02x}")
        if event == COMMAND_COMPLETE:
            return


def main():
    """Bind the Linux management channel; Python's HCI bind lacks channel on some builds."""
    if len(sys.argv) != 2 or not re.fullmatch(r"hci[0-9]+", sys.argv[1]):
        raise ValueError("Usage: clear-mesh-receiver hci<number>")
    index = int(sys.argv[1][3:])
    if index >= 0xFFFF:
        raise ValueError("Controller index is out of range")
    with socket.socket(socket.AF_BLUETOOTH, socket.SOCK_RAW, socket.BTPROTO_HCI) as sock:
        libc = ctypes.CDLL(None, use_errno=True)
        libc.bind.argtypes = (ctypes.c_int, ctypes.c_void_p, ctypes.c_uint)
        libc.bind.restype = ctypes.c_int
        # Native-endian sockaddr_hci: family, MGMT_INDEX_NONE, HCI_CHANNEL_CONTROL.
        address = ctypes.create_string_buffer(struct.pack("=HHH", socket.AF_BLUETOOTH, 0xFFFF, 3))
        if libc.bind(sock.fileno(), address, 6) != 0:
            error = ctypes.get_errno()
            raise OSError(error, "Cannot bind Bluetooth management channel")
        disable_receiver(sock, index)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError) as error:
        print(f"clear-mesh-receiver: {error}", file=sys.stderr)
        sys.exit(1)
