// Limit Mesh radio handoff to the packaged root service.
// This grants no rights to login accounts.
polkit.addRule(function(action, subject) {
    if (subject.user === "root" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") === "bluetooth-mesh.service" ||
         action.lookup("unit") === "mrs-uav-bluetooth-le-radio.service") &&
        (action.lookup("verb") === "start" || action.lookup("verb") === "stop")) {
        return polkit.Result.YES;
    }
});
