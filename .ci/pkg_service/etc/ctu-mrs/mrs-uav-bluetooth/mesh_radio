# System-service settings for bluetooth-meshd.
# generic: exclusive raw HCI; tested on both target controller types.
# auto: BlueZ chooses MGMT/raw HCI; use only after validating your radio stack.
MRS_UAV_BLUETOOTH_MESH_IO=generic
# Empty chooses the sole controller; multiple-controller hosts must choose one.
MRS_UAV_BLUETOOTH_MESH_ADAPTER=
