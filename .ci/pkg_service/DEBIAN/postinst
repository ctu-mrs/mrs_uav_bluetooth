#!/bin/bash
set -e

#remove pre-existing version of the systemctl service
if systemctl is-active --quiet mrs-uav-bluetooth 2>/dev/null; then
  systemctl stop mrs-uav-bluetooth
fi
if systemctl is-enabled --quiet mrs-uav-bluetooth 2>/dev/null; then
  systemctl disable mrs-uav-bluetooth
fi
if [ -f /etc/systemd/system/mrs-uav-bluetooth.service ]; then
  rm /etc/systemd/system/mrs-uav-bluetooth.service
fi
systemctl daemon-reload
systemctl reset-failed 2>/dev/null || true

SERVICE_USER=""
if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
  SERVICE_USER="$SUDO_USER"
elif [ -n "$PKEXEC_UID" ]; then
  SERVICE_USER=$(id -nu "$PKEXEC_UID" 2>/dev/null || true)
else
  SERVICE_USER=$(logname 2>/dev/null || true)
fi

if [ -z "$SERVICE_USER" ] || ! id "$SERVICE_USER" >/dev/null 2>&1; then
  echo "$0: failed to determine the installing user" >&2
  exit 1
fi

SERVICE_GROUP=$(id -gn "$SERVICE_USER")
SERVICE_HOME=$(getent passwd "$SERVICE_USER" | cut -d: -f6)

if [ -z "$SERVICE_HOME" ]; then
  echo "$0: failed to determine home directory for user $SERVICE_USER" >&2
  exit 1
fi

#setup new systemctl service
install -d -o "$SERVICE_USER" -g "$SERVICE_GROUP" "$SERVICE_HOME/.ros/log"
chmod +x /etc/ctu-mrs/mrs-uav-bluetooth/service_exec.sh
touch /etc/systemd/system/mrs-uav-bluetooth.service
> /etc/systemd/system/mrs-uav-bluetooth.service
echo "[Unit]
Description=ROS 2 MRS UAV Bluetooth node service
After=network.target
StartLimitIntervalSec=0
[Service]
Type=simple
Restart=always
User=$SERVICE_USER
Group=$SERVICE_GROUP
WorkingDirectory=$SERVICE_HOME
Environment=HOME=$SERVICE_HOME
Environment=USER=$SERVICE_USER
Environment=LOGNAME=$SERVICE_USER
Environment=ROS_HOME=$SERVICE_HOME/.ros
Environment=ROS_LOG_DIR=$SERVICE_HOME/.ros/log
ExecStart=/etc/ctu-mrs/mrs-uav-bluetooth/service_exec.sh
[Install]
WantedBy=multi-user.target" >> /etc/systemd/system/mrs-uav-bluetooth.service
systemctl daemon-reload
systemctl enable mrs-uav-bluetooth
systemctl start mrs-uav-bluetooth